{
  "name": "java-harness-desktop",
  "productName": "Java Harness",
  "version": "0.2.1",
  "private": true,
  "description": "Java Harness 桌面客户端",
  "author": "Java Harness",
  "type": "module",
  "main": "src/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "prepare:backend": "node scripts/prepare-backend.mjs",
    "dist": "node scripts/prepare-backend.mjs && electron-builder --win nsis --x64",
    "dist:dir": "node scripts/prepare-backend.mjs && electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "dev.javaharness.desktop",
    "productName": "Java Harness",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "Java-Harness-Setup-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "song782360037",
      "repo": "java-harness"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Java Harness"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "js-yaml": "4.3.2"
  }
}
