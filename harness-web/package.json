{
  "name": "harness-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "test:theme": "node --test tests/theme.test.mjs",
    "test": "node --experimental-strip-types --test tests/theme.test.mjs tests/preferences.test.mjs tests/markdown.test.mjs tests/fileDiff.test.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "diff": "9.0.0",
    "markdown-it": "15.0.1",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vue-tsc": "3.3.11"
  }
}
